{
  "name": "cortex",
  "private": true,
  "version": "0.1.0",
  "description": "Cortex: a single-canvas developer command center (Electron)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "dev:web": "vite --config vite.web.config.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint --ignore-pattern \".claude/**\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "icons": "electron scripts/make-icons.cjs"
  },
  "dependencies": {
    "cross-spawn": "7.0.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dynatrace/strato-components": "^3.17.1",
    "@dynatrace/strato-design-tokens": "^1.8.1",
    "@dynatrace/strato-icons": "^2.6.1",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-query": "5.104.5",
    "@types/cross-spawn": "6.0.6",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "anser": "2.3.5",
    "d3-force": "^3.0.1",
    "diff2html": "3.4.56",
    "electron": "44.10.0",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "highlight.js": "11.12.0",
    "mermaid": "12.2.0",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^7.0.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "5.0.5",
    "zustand": "5.0.16"
  },
  "author": "Cortex"
}
